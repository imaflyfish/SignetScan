@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(nlohmann_json 3.12)
find_dependency(OpenSSL 3 COMPONENTS Crypto)
find_dependency(PkgConfig)
pkg_check_modules(PLIST REQUIRED IMPORTED_TARGET libplist-2.0>=2.7)
pkg_check_modules(PCRE2 REQUIRED IMPORTED_TARGET libpcre2-8>=10.40)
include("${CMAKE_CURRENT_LIST_DIR}/SignetScanTargets.cmake")
